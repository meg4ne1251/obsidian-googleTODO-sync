{
  "name": "obsidian-gtodo-sync",
  "version": "0.1.0",
  "description": "Obsidian plugin for todo-*.md cards & inline editing.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "google tasks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.0",
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.4.16",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
